# Copy to .env and fill in. NEVER commit the real .env.

# BNB Chain RPC endpoint
# Public options: https://docs.bscscan.com/misc-tools-and-utilities/public-rpc-nodes
BSC_RPC_URL=https://bsc-dataseed.binance.org/

# Wallet — use a dedicated burner wallet funded with only what you can lose.
WALLET_ADDRESS=0xYourAddressHere
PRIVATE_KEY=0xYourPrivateKeyHere

# Strategy parameters
BET_AMOUNT_BNB=0.01   # stake per round, in BNB
EV_THRESHOLD=0.25     # bet only when naive EV (at p=0.5) exceeds this
CLAIM_LOOKBACK=100    # how many past rounds to scan for unclaimed winnings

# Safety: true = log would-be bets without sending any transaction
DRY_RUN=true
